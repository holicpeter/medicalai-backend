# Copy to .env and fill in. .env is gitignored and must stay out of the repo —
# it holds live credentials, and this repository is public.
#
# In production these are set as Railway variables, not from a file. Watch for
# trailing spaces in variable NAMES there: "MISTRAL_API_KEY " is a different
# variable from "MISTRAL_API_KEY" and silently never reaches settings.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. Unset falls back to local SQLite.
DATABASE_URL=

# --- Models -----------------------------------------------------------------
# The chat prefers Mistral when MISTRAL_API_KEY is set and falls back to Claude.
# Only the Claude path supports tool calling (app/chat_tools.py).
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# --- API --------------------------------------------------------------------
BACKEND_HOST=localhost
BACKEND_PORT=8000
# Also signs auth session cookies (JWT, HS256) — must be a long random value
# in production, not the default. Rotating it logs out every session.
SECRET_KEY=

# --- Auth ---------------------------------------------------------------
# Comma-separated (or JSON array) list of emails allowed to use the
# Garmin/Withings/Calendar integration endpoints — those connectors hold one
# OAuth session per process, not per user, so they are restricted to the
# account(s) that actually own that hardware. See app/config.py.
ADMIN_EMAILS=
# Set to false only for local http://localhost development. Must stay true
# anywhere served over https (Railway/production), or the session cookie is
# dropped by the browser.
AUTH_COOKIE_SECURE=true

# Shared secret with the Cloudflare Worker in front of this API. When set, only
# requests carrying it in X-Proxy-Secret are served. Empty disables the check.
PROXY_SHARED_SECRET=

# --- Withings ---------------------------------------------------------------
# WITHINGS_REDIRECT_URI must match the Callback URL registered at
# developer.withings.com character for character.
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=

# --- OCR --------------------------------------------------------------------
TESSERACT_LANG=slk
